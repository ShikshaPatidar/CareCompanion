# Copy to .env and fill in. Never commit .env.
# From the Foundry portal (project overview page):
FOUNDRY_PROJECT_ENDPOINT=https://carecompanion-foundry.services.ai.azure.com/api/projects/carecompanion
FOUNDRY_RESOURCE_ENDPOINT=https://carecompanion-foundry.cognitiveservices.azure.com/
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Optional
POLICY_AGENT_NAME=elmfield-policy-agent
# Use the .NET appointments service instead of the local JSON files:
# APPOINTMENTS_API_URL=http://localhost:5080
# APPOINTMENTS_API_KEY=change-me
# Use our own MCP server for scheduling tools (experimental):
# SCHEDULING_MCP_URL=http://localhost:8765/mcp
# Send traces to Application Insights (pip install -e ".[telemetry]"):
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# AUDIT_LOG_CONTENT=false
